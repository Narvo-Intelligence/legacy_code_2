# Narvo Backend – copy to .env and fill in real values. Do not commit .env.

# Supabase (auth + DB: bookmarks, preferences, briefings, offline, listening_history, tts_cache, push)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Required for /api/me/* and any route using Bearer auth: same value as Supabase Dashboard → Project Settings → API → JWT Secret
# SUPABASE_JWT_SECRET=your-jwt-secret

# Gemini (narrative, translation, briefing, recommendations)
GEMINI_API_KEY=your-gemini-api-key

# YarnGPT (primary TTS for Nigerian voices – Yoruba, Igbo, Hausa, Pidgin, English)
# Omit to use OpenAI TTS only.
# YARNGPT_API_KEY=your-yarngpt-api-key

# Prefill: first N *new* stories per batch get TTS for all preload languages (yo, ha, ig, pcm), not only breaking.
# Breaking/urgent still prioritized. Set 0 for English-only + breaking-only local audio (legacy behavior).
# PREFILL_ALL_LANG_AUDIO_MAX_STORIES=20

# If you upload TTS files to object storage (e.g. Supabase Storage / GCS), set long Cache-Control on objects
# (e.g. public, max-age=31536000, immutable) so repeat plays hit the CDN edge. Data-URL responses skip this.
# Supabase Storage audio transport for broadcasts/briefings. Bucket will be auto-created on first upload when allowed.
# SUPABASE_AUDIO_STORAGE_ENABLED=true
# SUPABASE_AUDIO_BUCKET=narvo-audio
# SUPABASE_AUDIO_PATH_PREFIX=tts
# SUPABASE_AUDIO_PUBLIC=true
# SUPABASE_AUDIO_AUTO_CREATE_BUCKET=true
# SUPABASE_AUDIO_CACHE_CONTROL=public, max-age=31536000, immutable

# OpenAI (TTS fallback when YarnGPT fails or key not set)
OPENAI_API_KEY=your-openai-api-key

# Optional: Google Fact Check API (omit for mock responses)
# GOOGLE_FACT_CHECK_API_KEY=your-google-api-key

# CORS: comma-separated browser origins. Omit, *, or empty = default (narvo.news, www.narvo.news, localhost).
# Extra origins are merged with those defaults so www vs apex is never missing by mistake.
# FRONTEND_ORIGIN=https://www.narvo.news,https://narvo.news

# Public web app URL for Open Graph fallbacks (og:image when a pick has no image_url). Defaults to https://narvo.news
# PUBLIC_SITE_URL=https://narvo.news

# Optional: Sentry error tracking (omit to disable)
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_ENVIRONMENT=production

# Morning Briefing cron (QStash or any 5am trigger). Pass as Bearer or X-Cron-Secret to POST /api/briefing/cron
# BRIEFING_CRON_SECRET=your-random-secret

# Upstash (Redis + Ratelimit use same Redis instance; QStash for scheduled jobs)
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token
# QSTASH_TOKEN=your-qstash-token
# Weekly TTS row cleanup: POST /api/cron/tts-cache-cleanup?days=30 (same auth as other cron routes).
# QStash request signature verification (Upstash dashboard → QStash → Signing Keys)
# Set both — the NEXT key is used during key rotation to avoid downtime.
# QSTASH_CURRENT_SIGNING_KEY=sig_xxxxxxxxxxxxxxxx
# QSTASH_NEXT_SIGNING_KEY=sig_xxxxxxxxxxxxxxxx
# Legacy fallback (used when signing keys are absent, e.g. local dev):
# QSTASH_CRON_SECRET=your-random-secret

# Web push (after briefing cron). Optional; omit to skip push.
# VAPID_PRIVATE_KEY=your-vapid-private-key
# VAPID_SUB_CLAIM=mailto:ops@yourdomain.com

# Upstash Vector (semantic recommendations; index dimension must be 768 to match Gemini output_dimensionality)
# UPSTASH_VECTOR_REST_URL=https://xxx.upstash.io
# UPSTASH_VECTOR_REST_TOKEN=your-token

# Podcast Index (optional — enriches /api/podcasts with more African-focused episodes)
# https://podcastindex.org/
# PODCASTINDEX_API_KEY=your-key
# PODCASTINDEX_API_SECRET=your-secret
