# Copy to `.env.local` and fill in. Do not commit secrets you do not intend to share.

# Site origin for share links (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Narvo FastAPI — local dev or https://api.narvo.news in production
NEXT_PUBLIC_NARVO_API_URL=http://127.0.0.1:8000

# Legacy fallback (optional) if older tooling still sets it
# NEXT_PUBLIC_BACKEND_URL=

# Gemini — landing voice modal (`app/page.tsx`)
NEXT_PUBLIC_GEMINI_API_KEY=

# Supabase (browser anon key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Edge function (optional)
NEXT_PUBLIC_EDGE_NEWS_URL=

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=

# Web Push (optional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Legacy AI Studio / hosting template (unused by Next unless you reference it)
# APP_URL=
