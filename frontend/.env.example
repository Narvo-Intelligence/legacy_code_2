# Narvo Frontend – copy to .env and fill in real values. Do not commit .env.
# Vite only exposes env vars prefixed with VITE_ to the client.

# Backend API base URL (no trailing slash).
# Local dev: use http://localhost:8000 and run the backend locally. Using https://api.narvo.news from localhost causes CORS and (if edge is used) 502s.
VITE_BACKEND_URL=http://localhost:8000

# Optional: Supabase Edge Function URL for news list (regional caching / Nigerian edge). When set, GET api/news uses this.
# Local dev: leave unset so requests go to VITE_BACKEND_URL; the edge can return 502 if upstream is unreachable.
# Example: https://YOUR_PROJECT.supabase.co/functions/v1/narvo-news-edge
# VITE_EDGE_NEWS_URL=

# Public site URL (for OAuth redirects, sharing; defaults to window.location.origin)
# Production: https://narvo.news
VITE_PUBLIC_URL=http://localhost:3000

# Supabase (auth) – must match backend Supabase project
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: Sentry error tracking (omit to disable)
# VITE_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Optional: set to "true" to load Vercel Web Analytics.
# Omit or leave unset to disable analytics.

# VITE_VERCEL_ANALYTICS=true

# Optional: URL to a 10-second Narvo voice sample (e.g. Pidgin or Standard). When set, Hero shows "Listen to Narvo" and plays this URL.
# VITE_HERO_VOICE_SAMPLE_URL=https://your-cdn.com/narvo-hero-sample.mp3
